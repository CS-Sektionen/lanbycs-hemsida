---
interface Props {
  to: string;
}

const { to } = Astro.props;
---

<div
  class="absolute bottom-6 left-1/2 flex -translate-x-1/2 items-center md:bottom-8"
  aria-label="Countdown to the LAN party"
  data-countdown
  data-target-time={to}
>
  <span
    data-unit="days"
    class="flex items-baseline gap-1 bg-bg-accent p-1 md:flex-col md:items-center md:gap-0 md:p-4"
  >
    <span class="font-display text-2xl md:text-4xl" data-value>
      00
    </span>
    <span class="text-text-subtle md:hidden">d</span>
    <span class="text-text-subtle hidden md:block">days</span>
  </span>
  <span class="px-1 pb-1 font-display text-2xl opacity-50 md:pb-7 md:text-4xl">
    :
  </span>
  <span
    data-unit="hours"
    class="flex items-baseline gap-1 bg-bg-accent p-1 md:flex-col md:items-center md:gap-0 md:p-4"
  >
    <span class="font-display text-2xl md:text-4xl" data-value>
      00
    </span>
    <span class="text-text-subtle md:hidden">h</span>
    <span class="text-text-subtle hidden md:block">hours</span>
  </span>
  <span class="px-1 pb-1 font-display text-2xl opacity-50 md:pb-7 md:text-4xl">
    :
  </span>
  <span
    data-unit="minutes"
    class="flex items-baseline gap-1 bg-bg-accent p-1 md:flex-col md:items-center md:gap-0 md:p-4"
  >
    <span class="font-display text-2xl md:text-4xl" data-value>
      00
    </span>
    <span class="text-text-subtle md:hidden">m</span>
    <span class="text-text-subtle hidden md:block">minutes</span>
  </span>
  <span class="px-1 pb-1 font-display text-2xl opacity-50 md:pb-7 md:text-4xl">
    :
  </span>
  <span
    data-unit="seconds"
    class="flex items-baseline gap-1 bg-bg-accent p-1 md:flex-col md:items-center md:gap-0 md:p-4"
  >
    <span class="font-display text-2xl md:text-4xl" data-value>
      00
    </span>
    <span class="text-text-subtle md:hidden">s</span>
    <span class="text-text-subtle hidden md:block">seconds</span>
  </span>
</div>

<script>
  // This code might not be the most elegant (it's vibe-coded), but it works :)

  const updateCountdowns = () => {
    document
      .querySelectorAll<HTMLElement>("[data-countdown]")
      .forEach((countdown) => {
        const targetTime = countdown.dataset.targetTime;
        const targetTimeMs = targetTime ? new Date(targetTime).getTime() : NaN;
        const remainingSeconds = Number.isNaN(targetTimeMs)
          ? 0
          : Math.max(0, Math.floor((targetTimeMs - Date.now()) / 1000));

        const values = {
          days: Math.floor(remainingSeconds / 86400),
          hours: Math.floor((remainingSeconds % 86400) / 3600),
          minutes: Math.floor((remainingSeconds % 3600) / 60),
          seconds: remainingSeconds % 60,
        };

        Object.entries(values).forEach(([unit, value]) => {
          const valueElement = countdown.querySelector(
            `[data-unit="${unit}"] [data-value]`,
          );
          if (valueElement)
            valueElement.textContent = String(value).padStart(2, "0");
        });
      });
  };

  updateCountdowns();
  window.setInterval(updateCountdowns, 1000);
</script>
