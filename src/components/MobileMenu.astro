---
import Icon from "./Icon.astro";
import LogoHorizontal from "../assets/logo-horizontal.svg";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<div
  class="fixed inset-0 z-20 flex translate-x-full flex-col gap-12 bg-bg-accent p-6 text-white transition-transform duration-300 md:hidden [&.is-open]:translate-x-0"
  data-mobile-menu
>
  <div class="flex justify-end">
    <button
      class="cursor-pointer"
      type="button"
      aria-label="Close menu"
      data-menu-close
    >
      <Icon name="close" class="text-[32px]! text-text-inverted" />
    </button>
  </div>
  <nav
    class="flex flex-col flex-1 justify-center gap-8 font-display text-4xl"
    aria-label="Mobile navigation"
  >
    <a
      href="/"
      class={`flex justify-between items-center transition-colors hover:text-text-inverted ${currentPath === "/" ? "text-text-inverted" : ""}`}
      aria-current={currentPath === "/" ? "page" : undefined}
    >
      <span>HOME</span>
      {currentPath !== "/" && (
        <Icon name="arrow_forward" class="text-[32px]!" />
      )}
    </a>
    <a
      href="/schedule"
      class={`flex justify-between items-center transition-colors hover:text-text-inverted ${currentPath === "/schedule" ? "text-text-inverted" : ""}`}
      aria-current={currentPath === "/schedule" ? "page" : undefined}
    >
      <span>SCHEDULE</span>
      {currentPath !== "/schedule" && (
        <Icon name="arrow_forward" class="text-[32px]!" />
      )}
    </a>
    <a
      href="/about"
      class={`flex justify-between items-center transition-colors hover:text-text-inverted ${currentPath === "/about" ? "text-text-inverted" : ""}`}
      aria-current={currentPath === "/about" ? "page" : undefined}
    >
      <span>ABOUT</span>
      {currentPath !== "/about" && (
        <Icon name="arrow_forward" class="text-[32px]!" />
      )}
    </a>
  </nav>
  <LogoHorizontal class="h-auto w-full text-text-inverted" />
</div>
