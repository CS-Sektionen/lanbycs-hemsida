---
import Icon from "./Icon.astro";
import LogoHorizontal from "../assets/logo-horizontal.svg";
---

<div
  class="fixed inset-0 z-20 flex translate-x-full flex-col gap-12 bg-bg-accent p-6 text-white transition-transform duration-300 md:hidden [&.is-open]:translate-x-0"
  data-mobile-menu
>
  <div class="flex justify-end">
    <button
      class="cursor-pointer"
      type="button"
      aria-label="Close menu"
      data-menu-close
    >
      <Icon name="close" class="text-[32px]! text-text-inverted" />
    </button>
  </div>
  <nav
    class="flex flex-col flex-1 justify-center gap-8 font-display text-4xl"
    aria-label="Mobile navigation"
  >
    <a href="/" class="flex justify-between items-center">
      <span>HOME</span>
      <Icon name="arrow_forward" class="text-[32px]!" />
    </a>
    <a href="/schedule" class="flex justify-between items-center">
      <span>SCHEDULE</span>
      <Icon name="arrow_forward" class="text-[32px]!" />
    </a>
    <a href="/about" class="flex justify-between items-center">
      <span>ABOUT</span>
      <Icon name="arrow_forward" class="text-[32px]!" />
    </a>
  </nav>
  <LogoHorizontal class="h-auto w-full text-text-inverted" />
</div>
