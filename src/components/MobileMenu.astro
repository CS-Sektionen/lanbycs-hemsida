---
import Icon from "./Icon.astro";
---

<div
  class="fixed inset-0 z-20 flex translate-x-full flex-col gap-12 bg-bg-subtle p-6 text-white transition-transform duration-300 md:hidden [&.is-open]:translate-x-0"
  data-mobile-menu
>
  <button
    class="self-end border-0 bg-transparent text-white"
    type="button"
    aria-label="Close menu"
    data-menu-close
  >
    <Icon name="close" />
  </button>
  <nav
    class="flex flex-col gap-6 font-display text-4xl"
    aria-label="Mobile navigation"
  >
    <a href="#home">Home</a>
    <a href="#schedule">Schedule</a>
    <a href="#about">About</a>
    <a href="#faq">FAQ</a>
  </nav>
</div>
