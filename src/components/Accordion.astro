---
import Icon from "./Icon.astro";

interface Props {
  question: string;
  answer: string;
  open?: boolean;
}

const { question, answer, open = false } = Astro.props;
---

<details class="group bg-bg-subtle open:bg-bg-accent" open={open}>
  <summary class="flex cursor-pointer list-none justify-between gap-4 p-4 font-bold">
    {question}
    <Icon name="keyboard_arrow_down" class="group-open:rotate-180" />
  </summary>
  <p class="px-4 pb-4 text-text-subtle">{answer}</p>
</details>
