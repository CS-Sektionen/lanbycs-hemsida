---
import Layout from "../layouts/Layout.astro";
import ScheduleItem from "../components/ScheduleItem.astro";
import ScheduleDivider from "../components/ScheduleDivider.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";
import cansImage from "../assets/cans.jpg";
---

<Layout>
  <!-- Schedule -->
  <section class="px-6 pb-6 pt-24 md:px-16 md:pb-16 md:pt-32" id="schedule">
    <div class="container mx-auto flex flex-col gap-8 md:grid md:grid-cols-2 md:gap-8">
      <div class="flex flex-col items-start gap-4">
        <p class="font-bold text-text-subtle">AUTUMN 2026 (LANBYCS #17)</p>
        <h2 class="font-display text-3xl md:text-5xl text-balance">
          SCHEDULE
        </h2>
        <p class="max-w-160 text-text-subtle">
          Here's what's planned for the event. Note that times are approximate and may change, so check our Discord server for the latest updates. Of course, you can also just show up and play whatever you like!
        </p>
        <Button href="https://discord.gg/PDe8W4EA4V" variant="secondary">
          Join our Discord
        </Button>
      </div>
      <ul class="flex flex-col gap-4">
        <ScheduleDivider text="FRIDAY 20 NOV" />
        <ScheduleItem
          title="Doors open"
          description="Welcome to the LAN! Grab your seat and get yourself set up."
          time="17:00"
        />
        <ScheduleItem
          title="Geoguessr"
          description="Geographically outguess your peers in this free-for-all!"
          time="19:00"
          isCompetition
        />
        <ScheduleItem
          title="Super Smash Bros Ultimate"
          description="Battle it out in this ultimate platform fighter tournament!"
          time="23:00"
          isCompetition
        />
        <ScheduleDivider text="SATURDAY 21 NOV" />
        <ScheduleItem
          title="Mario Kart World"
          description="Race to victory in the latest Mario Kart game making its debut at the LAN!"
          time="15:00"
          isCompetition
        />
        <ScheduleItem
          title="Minecraft"
          description="Compete in various mini-games on our very own MCbyCS Minecraft server!"
          time="19:00"
          isCompetition
        />
        <ScheduleItem
          title="Deadlock"
          description="Be one of the first to try out Valve's in-development game. We have some private invites..."
          time="22:00"
          isCompetition
        />
        <ScheduleDivider text="SUNDAY 22 NOV" />
        <ScheduleItem
          title="Paper plane contest"
          description="Fold your best paper plane and see how far it can fly! It's our traditional closing event."
          time="12:00"
          isCompetition
        />
      </ul>
    </div>
  </section>

  <!-- Image -->
  <section class="border-t-2 border-bg-subtle px-6 py-8 md:p-16">
    <div class="relative container mx-auto">
      <Image
        class="block h-48 w-full object-cover md:h-128"
        src={cansImage}
        alt="Energy drinks and a Rubik's cube on top of a computer case"
      />
      <div class="pointer-events-none absolute inset-0 bg-bg-accent mix-blend-color" />
    </div>
  </section>
</Layout>
