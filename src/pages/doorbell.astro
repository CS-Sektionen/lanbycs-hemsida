---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import amongUsImage from "../assets/among-us.jpg";
import DoorbellForm from "../components/DoorbellForm.astro";
---

<Layout>
  <!-- Doorbell -->
  <section class="px-6 pb-6 pt-24 md:px-16 md:pb-16 md:pt-32" id="bio">
    <div class="container mx-auto flex flex-col gap-8 md:grid md:grid-cols-2 md:gap-8">
      <div class="flex flex-col items-start gap-4">
        <h2 class="font-display text-3xl md:text-5xl text-balance">
          STANDING OUTSIDE?
        </h2>
        <p class="max-w-160 text-text-subtle">
          Ring the digital doorbell and a crew member will be notified to open
          the door. If it doesn't work, contact us via the{" "}
          <a href="https://discord.gg/PDe8W4EA4V" class="underline">
            Discord server
          </a>
          .
        </p>
      </div>
      <DoorbellForm
        entrances={[
          {
            name: "Main entrance",
            description: "The main entrance to the building",
          },
          {
            name: "Side entrance",
            description: "The side entrance to the building",
          },
        ]}
      />
    </div>
  </section>

  <!-- Image -->
  <section class="border-t-2 border-bg-subtle px-6 py-8 md:p-16">
    <div class="relative container mx-auto">
      <Image
        class="block h-48 w-full object-cover md:h-128"
        src={amongUsImage}
        alt="Circle of people playing Among Us together"
      />
      <div class="pointer-events-none absolute inset-0 bg-bg-accent mix-blend-color" />
    </div>
  </section>
</Layout>
